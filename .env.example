PORT=8080
KICK_CLIENT_ID=your_kick_client_id
KICK_CLIENT_SECRET=your_kick_client_secret
ALLOWED_REDIRECT_URIS=https://localhost/callback,https://127.0.0.1/callback
UPSTREAM_TIMEOUT_MS=10000
TRUST_PROXY=loopback
LOG_LEVEL=info

# When set, all /v1/kick/oauth endpoints require HMAC request signing.
# with these headers: X-Auth-Timestamp (unix seconds), X-Auth-Nonce (unique string)
# and X-Auth-Signature (hex HMAC-SHA256 over "timestamp\nnonce\nMETHOD\npathname\nsha256hex(body)").
# Keep this set on internet-facing deployments. The secret is defense-in-depth,
# not a durable client secret: anything embedded in an APK can be extracted.
APP_HMAC_SECRET=
# Development-only escape hatch. Production deployments must leave this false.
ALLOW_UNAUTHENTICATED_OAUTH=false
HMAC_TIMESTAMP_TOLERANCE_SECONDS=300

# Optional anonymous usage counter. The app sends a random per-install
# identifier to /v1/metrics/ping at most once per day (opt-out in app settings).
# The identifier is a client-generated random seed hashed with METRICS_SALT on
# the server; it is stable per install so returning devices are not recounted
# as installs. Set METRICS_SALT to any random hex string (e.g. `openssl rand -hex 32`)
# to enable collection.
# METRICS_SALT=
# METRICS_ACCOUNT_SALT=
# Set to a long random string to enable /v1/metrics/stats and /v1/metrics/dashboard.
# METRICS_ADMIN_TOKEN=
# Persist counters between restarts (recommended). Path is relative to the cwd.
# METRICS_DATA_FILE=./data/metrics.json
# How many months of history to keep (default 3; the dashboard can chart up to 90 days).
# METRICS_RETENTION_MONTHS=3
# Maximum unique device hashes retained for the current month.
# METRICS_MAX_DEVICES_PER_MONTH=100000
# Maximum install-dedup entries (64-bit hash prefixes, no activity data). When
# reached, install totals become best-effort until entries are freed.
# METRICS_MAX_EVERSEEN=250000
# Path to a static admin HTML page served at /v1/metrics/dashboard.
METRICS_DASHBOARD_FILE=./dashboard.html

# Optional FCM Push Notification Relay
# Path to your Firebase service account JSON key file (downloaded from Firebase Console)
# FCM_SERVICE_ACCOUNT_KEY_PATH=./firebase-service-account.json
# Path to persist push subscriptions (default: ./data/fcm_subscriptions.json)
# FCM_DATA_FILE=./data/fcm_subscriptions.json
# Whether to enable the Pusher WebSocket relay service (default: true if service account is present)
# FCM_PUSHER_RELAY_ENABLED=true
